# Application Settings
PROJECT_NAME="Spam Message Detection System"
PORT=5001

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./spam_detector.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/spam_detector_db

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://myfrontend.vercel.app)
CORS_ORIGINS=*

# Path to trained model artifacts
ARTIFACTS_DIR=./artifacts
